APP_NAME="Mapa Electoral Caldas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mapa_electoral
DB_USERNAME=mapa_electoral_user
DB_PASSWORD=change_me_in_production

SESSION_DRIVER=redis
SESSION_LIFETIME=20
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mapa_electoral

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mapaelectoral.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cifrado de campos sensibles
FIELD_ENCRYPTION_KEY=
# Clave para índice ciego de cédulas (HMAC)
CEDULA_HASH_KEY=

# Google 2FA
GOOGLE2FA_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Archivos
MAX_UPLOAD_SIZE=10240
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Geodatos
DEFAULT_SRID=4326
MAP_CENTER_LAT=5.0689
MAP_CENTER_LNG=-75.5174
MAP_ZOOM_INITIAL=9

# Vistas materializadas - refresh interval (minutes)
MV_REFRESH_INTERVAL=5

# Retención de datos (días después del cierre electoral)
DATA_RETENTION_DAYS=90

VITE_APP_NAME="${APP_NAME}"

# CORS — orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
